%% Inbound filtering with prefix-list and route-map
flowchart TD
    IN(["UPDATE from neighbor"]) --> PL{"prefix-list<br/>permits the prefix?"}
    PL -- No --> D1(["Drop"])
    PL -- Yes --> RM{"route-map IN<br/>seq 10: AS-path<br/>matches bogon?"}
    RM -- Yes --> D2(["deny: drop"])
    RM -- No --> RM2{"seq 20: community<br/>65000:100 matches?"}
    RM2 -- Yes --> S1["set local-preference 200"]
    RM2 -- No --> S2["seq 30: set local-preference 100"]
    S1 --> OK(["Accepted into Adj-RIB-In"])
    S2 --> OK

