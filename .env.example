# Copie para .env e preencha. O .env real é gitignored.
MODEL_NAME=deepseek-v4-flash
URL=https://code.verboo.ai/router/v1
API_KEY=coloque-sua-chave-aqui
PROVIDER_NAME="Verboo Ai"

# Retrieval RAG (frr_docs em PostgreSQL + pgvector)
DATABASE_URL=postgres://postgres:minha-senha@localhost:5432/frr_rag
# O modelo DEVE ser o mesmo usado no ingester (dimensão 4096).
EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b
