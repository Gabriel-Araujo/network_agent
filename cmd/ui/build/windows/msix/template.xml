<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="net_agent"
        Arguments=""
        InstallLocation="C:\Program Files\Gabriel\Network Agent">
    </Installer>
    <PackageInformation
        PackageName="Network Agent"
        PackageDisplayName="Network Agent"
        PublisherName="CN=Gabriel"
        PublisherDisplayName="Gabriel"
        Version="0.1.0.0"
        PackageDescription="Agente de LLM para engenharia de rede com FRRouting">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.gabriel.netagent"
                Description="Agente de LLM para engenharia de rede com FRRouting"
                DisplayName="Network Agent"
                ExecutableName="net_agent"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Network Agent</DisplayName>
            <PublisherDisplayName>Gabriel</PublisherDisplayName>
            <Description>Agente de LLM para engenharia de rede com FRRouting</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="net_agent.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
